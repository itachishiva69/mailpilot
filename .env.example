# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=
# Random shared secret used to validate Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=

# Groq model provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Neon PostgreSQL pooled connection URI (keep secret)
DATABASE_URL=

# Google OAuth Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Render sets RENDER_EXTERNAL_URL automatically. Optionally set PUBLIC_BASE_URL to the service HTTPS URL.
PUBLIC_BASE_URL=
# Optional override. If blank, derived as PUBLIC_BASE_URL/oauth/callback.
OAUTH_REDIRECT_URI=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Digest defaults (each user can configure their own digest)
DIGEST_TIMEZONE=Asia/Kolkata
DEFAULT_DIGEST_HOUR=8
DEFAULT_DIGEST_MINUTE=0

# Injected by Render; local default for direct ASGI testing
PORT=8000
